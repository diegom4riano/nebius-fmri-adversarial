# ============================================================
# Public repo: commit ONLY the code + configs needed to run the
# pipeline. Ignore these source/doc extensions by default, then
# whitelist (with !) the specific files that must be committed.
# (Note: .gitignore does not untrack already-committed files —
#  use `git rm --cached <file>` for those.)
# ============================================================
*.py
*.yaml
*.yml
*.tex
*.md
*.txt

# --- Pipeline code (Python) — CORE REPRODUCTION ONLY (kappa + profile + sweep) ---
!hessian.py
!test_fmri_model.py
!test_pytorch_model.py
!test_pathomic_model.py
!test_pathomic_qp.py
!train_fmri.py
!generate_figures.py
!model/*.py
!utils/*.py
# core scripts only — the analysis & clinical arm in scripts/clinical/ stays ignored
!scripts/profile_geometry.py
!scripts/profile_geometry_pathomic.py
!scripts/geometry_routing.py
!scripts/paired_stats.py
!scripts/analyze_sweep.py
!scripts/hvp_validation.py

# --- Configs needed to run the pipeline ---
!configs/config.yaml
!configs/config_ecg.yaml
!configs/config_damping_sweep.yaml

# --- Docs / dependencies to commit ---
!README.md
!requirements.txt
